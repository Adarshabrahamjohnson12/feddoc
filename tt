                page.get_image_rects(
                    xref
                )
            )


        except Exception as e:

            print(
                "Could not get image rect:",
                e
            )

            continue


        for rect in rects:


            # =================================================
            # PDF -> PIXELS
            # =================================================

            px1 = int(
                rect.x0
                *
                RENDER_SCALE
            )

            py1 = int(
                rect.y0
                *
                RENDER_SCALE
            )

            px2 = int(
                rect.x1
                *
                RENDER_SCALE
            )

            py2 = int(
                rect.y1
                *
                RENDER_SCALE
            )


            # =================================================
            # CLIP
            # =================================================

            px1 = max(
                0,
                min(
                    px1,
                    page_width - 1
                )
            )

            py1 = max(
                0,
                min(
                    py1,
                    page_height - 1
                )
            )

            px2 = max(
                0,
                min(
                    px2,
                    page_width
                )
            )

            py2 = max(
                0,
                min(
                    py2,
                    page_height
                )
            )


            iw = (
                px2 - px1
            )

            ih = (
                py2 - py1
            )


            # =================================================
            # IGNORE SMALL IMAGES
            # =================================================

            if (

                iw
                <
                page_width * 0.08

                or

                ih
                <
                page_height * 0.04
            ):

                continue


            # =================================================
