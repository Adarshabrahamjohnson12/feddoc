        print("FULL-PAGE SCAN RF-DETR")
        (
            page_detector_boxes,
            detector_aadhaar_count,
            detector_qr_count
        ) = process_full_page_scan(page_image)
        total_page_detector_aadhaar_masks += detector_aadhaar_count
        total_qr_masks += detector_qr_count


    # ========================================================
    # PART B
    # FORM-LEVEL LABEL-AWARE AADHAAR
    # ========================================================

    print()

    print("-" * 70)

    print(
        "FORM-LEVEL LABEL-AWARE OCR"
    )

    print("-" * 70)


    labeled_candidates = (
        find_labeled_form_aadhaar_candidates(
            page_image
        )
    )


    labeled_boxes = page_detector_boxes.copy()


    for candidate in (
        labeled_candidates
    ):


        box = candidate[
            "box"
        ]


        # ====================================================
        # CHECK DUPLICATES
        # ====================================================

        duplicate = False


        for existing_box in (
            labeled_boxes
        ):


            if (

                box_iou(

                    box,

                    existing_box
                )

                >
                0.50
            ):

                duplicate = True

                break


        if duplicate:

            continue


        mask_box = expand_box(

            box,

            page_width,

            page_height,

            AADHAAR_MARGIN_X,

            AADHAAR_MARGIN_Y
        )


        # ====================================================
        # MASK
        # ====================================================

        visible = draw_masked_aadhaar(

            page_image,

            mask_box,

            candidate[
                "number"
            ]
        )


        labeled_boxes.append(
            mask_box
        )


        total_labeled_form_masks += 1


        print()

        print(
            "FORM LABEL-AADHAAR MASKED"
        )

        print(
            "Visible:",
            visible
        )

        print(
            "Detection method:",
            candidate[
                "method"
            ]
        )


    # ========================================================
    # PART C
    # GENERIC FORM-LEVEL VERHOEFF SCAN
    #
    # This catches Aadhaar numbers that are not explicitly
    # next to an Aadhaar label.
    #
    # These MUST pass Verhoeff.
    # ========================================================

    print()

    print("-" * 70)

    print(
        "GENERIC FORM-LEVEL VERHOEFF SCAN"
    )

    print("-" * 70)


    generic_candidates = (
        find_aadhaar_candidates(
            page_image
        )
    )


    generic_boxes = []


    for candidate in (
        generic_candidates
    ):


        box = candidate[
            "box"
        ]


        # ====================================================
        # DON'T MASK IF ALREADY MASKED
        # ====================================================

        already_masked = False


        for existing_box in (
            labeled_boxes
        ):


            if (

                box_iou(

                    box,

                    existing_box
                )

                >
                0.40
            ):

                already_masked = True

                break


        if already_masked:

            continue


        for existing_box in (
            generic_boxes
        ):


            if (

                box_iou(

                    box,

                    existing_box
                )

                >
                0.40
            ):

                already_masked = True

                break


        if already_masked:

            continue


        # ====================================================
        # MASK
        # ====================================================

        mask_box = expand_box(

            box,

            page_width,

            page_height,

            AADHAAR_MARGIN_X,

            AADHAAR_MARGIN_Y
        )


        visible = draw_masked_aadhaar(

            page_image,

            mask_box,

            candidate[
                "number"
            ]
        )


        generic_boxes.append(
            mask_box
        )


        total_generic_verhoeff_form_masks += 1


        print()

        print(
            "FORM VERHOEFF-AADHAAR MASKED"
        )

        print(
            "Visible:",
            visible
        )


    # ========================================================
    # SAVE PAGE
    # ========================================================

    masked_pages.append(
        page_image
    )


    print()

    print(
        f"Page {page_index + 1} complete."
    )


