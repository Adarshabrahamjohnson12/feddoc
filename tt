def process_embedded_aadhaar(

    embedded_image
):


    image = (
        embedded_image.copy()
    )


    height, width = (
        image.shape[:2]
    )


    # ========================================================
    # RF-DETR
    # ========================================================

    pil = Image.fromarray(
        image
    )


    detections = model.predict(

        pil,

        threshold=
            RFDETR_THRESHOLD
    )


    print()

    print(
        "RF-DETR on embedded image:"
    )


    aadhaar_boxes = []

    qr_boxes = []

    detected_classes = []


    for (

        class_id,

        box,

        confidence

    ) in zip(

        detections.class_id,

        detections.xyxy,

        detections.confidence
    ):


        class_id = int(
            class_id
        )


        class_name = (
            CLASS_NAMES.get(

                class_id,

                str(class_id)
            )
        )


        box = clip_box(

            box,

            width,

            height
        )


        detected_classes.append(
            class_name
        )


        print(

            f"  {class_name} "

            f"confidence="

            f"{float(confidence):.3f} "

            f"box={box}"
        )


        if (
            class_name
            ==
            "AADHAAR_NUMBER"
        ):

            aadhaar_boxes.append(
                box
            )


        elif (
            class_name
            ==
            "QR"
        ):

            qr_boxes.append(
                box
            )


    # ========================================================
    # TESSERACT + VERHOEFF
    # ========================================================

    candidates = (
        find_aadhaar_candidates(
            image
        )
    )


    print(

        "  OCR valid Aadhaar candidates:",

        len(candidates)
    )


    masked = (
        image.copy()
    )


    masked_aadhaar_count = 0

    masked_qr_count = 0


    # ========================================================
    # QR
    # ========================================================

    for box in qr_boxes:


        mask_box = expand_box(

            box,

            width,

            height,

            QR_MARGIN_X,

            QR_MARGIN_Y
        )


        x1, y1, x2, y2 = (
            mask_box
        )


        cv2.rectangle(

            masked,

            (x1, y1),

            (x2, y2),

            (0, 0, 0),

            -1
        )


        masked_qr_count += 1


        print(
            "  QR MASKED:",
            mask_box
        )


    # ========================================================
    # MATCH RF-DETR WITH TESSERACT
    # ========================================================

    used_candidates = set()


    for detector_box in (
        aadhaar_boxes
    ):


        best_candidate_index = None

        best_iou = 0.0


        for idx, candidate in enumerate(
            candidates
        ):


            if idx in used_candidates:

                continue


            overlap = box_iou(

                candidate[
                    "box"
                ],

                detector_box
            )


            if overlap > best_iou:

                best_iou = overlap

                best_candidate_index = (
                    idx
                )


        # ====================================================
        # TESSERACT VALIDATED
        # ====================================================

        if (

            best_candidate_index
            is not None

            and

            best_iou > 0.05
        ):


            candidate = candidates[
                best_candidate_index
            ]


            number = candidate[
                "number"
            ]


            mask_box = expand_box(

                candidate[
                    "box"
                ],

                width,

                height,

                AADHAAR_MARGIN_X,

                AADHAAR_MARGIN_Y
            )


            visible = draw_masked_aadhaar(

                masked,

                mask_box,

                number
            )


            used_candidates.add(
                best_candidate_index
            )


            masked_aadhaar_count += 1


            print()

            print(
                "  EMBEDDED AADHAAR MASKED"
            )


            print(
                "  Visible:",
                visible
            )


        else:


            # =================================================
            # SAFETY FALLBACK
            # =================================================

            mask_box = expand_box(

                detector_box,

                width,

                height,

                AADHAAR_MARGIN_X,

                AADHAAR_MARGIN_Y
            )


            x1, y1, x2, y2 = (
                mask_box
            )


            cv2.rectangle(

                masked,

                (x1, y1),

                (x2, y2),

                (0, 0, 0),

                -1
            )


            masked_aadhaar_count += 1


            print()

            print(
                "  RF-DETR Aadhaar detected."
            )

            print(
                "  Tesseract validation failed."
            )

            print(
                "  SAFETY: fully masked."
            )


    # ========================================================
    # OCR-ONLY FALLBACK
    # ========================================================

    for idx, candidate in enumerate(
        candidates
    ):


        if idx in used_candidates:

            continue


        overlaps_detector = False


        for detector_box in (
            aadhaar_boxes
        ):


            if (

                box_iou(

                    candidate[
                        "box"
                    ],

                    detector_box
                )

                >

                0.05
            ):

                overlaps_detector = True

                break


        if overlaps_detector:

            continue


        number = candidate[
            "number"
        ]


        mask_box = expand_box(

            candidate[
                "box"
            ],

            width,

            height,

            AADHAAR_MARGIN_X,

            AADHAAR_MARGIN_Y
        )


        visible = draw_masked_aadhaar(

            masked,

            mask_box,

            number
        )


        masked_aadhaar_count += 1


        print()

        print(
            "  TESSERACT FALLBACK"
        )


        print(
            "  Visible:",
            visible
        )


    return (

        masked,

        masked_aadhaar_count,

        masked_qr_count,

        detected_classes,

        candidates
    )


def read_detected_aadhaar_number(image, box):
    height, width = image.shape[:2]
    x1, y1, x2, y2 = box
    padding_x = max(4, int((x2 - x1) * 0.04))
    padding_y = max(4, int((y2 - y1) * 0.35))
    crop = image[
        max(0, y1 - padding_y):min(height, y2 + padding_y),
        max(0, x1 - padding_x):min(width, x2 + padding_x)
    ]
    if crop.size == 0:
        return None

    gray = cv2.cvtColor(crop, cv2.COLOR_RGB2GRAY)
    enlarged = cv2.resize(
        gray,
        None,
        fx=2,
        fy=2,
        interpolation=cv2.INTER_CUBIC
    )
    versions = [
        enlarged,
        cv2.createCLAHE(clipLimit=3, tileGridSize=(8, 8)).apply(enlarged),
        cv2.threshold(
            enlarged,
            0,
            255,
            cv2.THRESH_BINARY + cv2.THRESH_OTSU
        )[1]
    ]

    jobs = [
        (
            processed,
            f"--psm {psm} -c tessedit_char_whitelist=0123456789"
        )
        for processed in versions
        for psm in (7, 8, 13)
    ]
    readings = {}
    for text in run_image_to_string_batch(jobs):
        digits = re.sub(r"\D", "", text)
        if len(digits) == 12:
            readings[digits] = readings.get(digits, 0) + 1

    if not readings:
        return None

    number, votes = max(readings.items(), key=lambda item: item[1])
    if votes < 2 or sum(votes == count for count in readings.values()) > 1:
        return None
    return number


def process_full_page_scan(page_image):
    height, width = page_image.shape[:2]
    tile_width = min(width, max(560, int(width * 0.36)))
    tile_height = min(height, max(560, int(height * 0.65)))

    def tile_starts(length, tile_size, stride):
        stride = max(1, stride)
        starts = list(range(0, max(1, length - tile_size + 1), stride))
        final_start = max(0, length - tile_size)
        if not starts or starts[-1] != final_start:
            starts.append(final_start)
        return starts

    detections = []
    y_starts = tile_starts(height, tile_height, int(height * 0.27))
    x_starts = tile_starts(width, tile_width, int(width * 0.34))
    for top in y_starts:
        for left in x_starts:
            tile = page_image[top:top + tile_height, left:left + tile_width]
            predictions = model.predict(
                Image.fromarray(tile),
                threshold=RFDETR_THRESHOLD
            )
            for class_id, box, confidence in zip(
                predictions.class_id,
                predictions.xyxy,
                predictions.confidence
            ):
                class_id = int(class_id)
                if class_id not in (2, 5):
                    continue
                x1, y1, x2, y2 = box
                page_box = clip_box(
                    (left + x1, top + y1, left + x2, top + y2),
                    width,
                    height
                )
                if page_box[2] <= page_box[0] or page_box[3] <= page_box[1]:
                    continue
                detections.append((class_id, page_box, float(confidence)))

    detections.sort(key=lambda item: item[2], reverse=True)
    unique_detections = []
    for detection in detections:
        class_id, box, _ = detection
        if any(
            class_id == existing_class
            and box_iou(box, existing_box) > 0.40
            for existing_class, existing_box, _ in unique_detections
        ):
            continue
        unique_detections.append(detection)

    masked_boxes = []
    aadhaar_count = 0
    qr_count = 0
    for class_id, box, confidence in unique_detections:
        mask_box = expand_box(
            box,
            width,
            height,
            QR_MARGIN_X if class_id == 5 else AADHAAR_MARGIN_X,
            QR_MARGIN_Y if class_id == 5 else AADHAAR_MARGIN_Y
        )
        x1, y1, x2, y2 = mask_box

        if class_id == 5:
            cv2.rectangle(page_image, (x1, y1), (x2, y2), (0, 0, 0), -1)
            qr_count += 1
            print(f"FULL-PAGE QR masked confidence={confidence:.3f} box={mask_box}")
        else:
            number = read_detected_aadhaar_number(page_image, box)
            if number:
                visible = draw_masked_aadhaar(
                    page_image,
                    mask_box,
                    number
                )
                print(
                    f"FULL-PAGE AADHAAR OCR masked confidence={confidence:.3f}; "
                    f"visible={visible} box={mask_box}"
                )
            else:
                cv2.rectangle(page_image, (x1, y1), (x2, y2), (0, 0, 0), -1)
                print(
                    f"FULL-PAGE AADHAAR detector fallback masked "
                    f"confidence={confidence:.3f} box={mask_box}"
                )
            aadhaar_count += 1

        masked_boxes.append(mask_box)

    return masked_boxes, aadhaar_count, qr_count


