stages:
  - validate
  - test
  - build
  - deploy_uat

variables:
  APP_NAME: "$CI_PROJECT_NAME"
  APP_PORT: "8080"
  DEPLOY_PATH: "C:/UAT_Apps/$CI_PROJECT_NAME"

# -------------------------------------------------------------------------
# STAGE 1: CI VALIDATION
# -------------------------------------------------------------------------
validate_project:
  stage: validate
  script:
    - echo "=== [BANK CI/CD] Validating Repository Contract for $APP_NAME ==="
    - |
      if find . -maxdepth 3 \( -name "*.csproj" -o -name "*.sln" -o -name "requirements.txt" -o -name "package.json" -o -name "pom.xml" \) | grep -q .; then
        echo "Project structure validated successfully!"
      else
        echo "ERROR: No supported project manifest found!"
        exit 1
      fi

# -------------------------------------------------------------------------
# STAGE 2: AUTOMATED TESTS
# -------------------------------------------------------------------------
run_automated_tests:
  stage: test
  script:
    - echo "=== [BANK CI/CD] Running Automated Tests for $APP_NAME ==="
    - |
      TARGET=$(find . -maxdepth 3 \( -name "*.sln" -o -name "*.csproj" \) | head -n 1)
      if [ -n "$TARGET" ]; then
        echo "Detected .NET project ($TARGET). Running dotnet test..."
        dotnet test "$TARGET" --nologo
      else
        echo "Skipping tests..."
      fi

# -------------------------------------------------------------------------
# STAGE 3: BUILD ARTIFACT
# -------------------------------------------------------------------------
build_artifact:
  stage: build
  script:
    - echo "=== [BANK CI/CD] Building Release Artifact for $APP_NAME ($CI_COMMIT_SHORT_SHA) ==="
    - mkdir -p build_output
    - |
      TARGET=$(find . -maxdepth 3 -name "*.csproj" | head -n 1)
      if [ -z "$TARGET" ]; then
        TARGET=$(find . -maxdepth 3 -name "*.sln" | head -n 1)
      fi
      if [ -n "$TARGET" ]; then
        echo "Publishing .NET Release Artifact ($TARGET) into build_output/..."
        dotnet publish "$TARGET" -c Release -o "./build_output" --nologo
      fi
  artifacts:
    paths:
      - build_output/
    expire_in: 1 week

# -------------------------------------------------------------------------
# STAGE 4: UAT DEPLOYMENT (Direct Copy to E:/sreejith/aeps/publish)
# -------------------------------------------------------------------------
deploy_to_uat:
  stage: deploy_uat
  environment:
    name: uat
    url: http://localhost:$APP_PORT
  script:
    - echo "=== [BANK CI/CD] Deploying $APP_NAME to $DEPLOY_PATH ==="
    - |
      mkdir -p "$DEPLOY_PATH"
      cp -r build_output/* "$DEPLOY_PATH"/
      echo "Successfully deployed files to $DEPLOY_PATH!"
