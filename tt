# 10. DRAW MASK
#
# Original:
#
#   1234 5678 9012
#
# Output:
#
#   XXXX XXXX 9012
# ============================================================

def draw_masked_aadhaar(

    canvas,

    box,

    number
):

    height, width = (
        canvas.shape[:2]
    )


    x1, y1, x2, y2 = clip_box(

        box,

        width,

        height
    )


    # ========================================================
    # WHITE OUT ORIGINAL
    # ========================================================

    cv2.rectangle(

        canvas,

        (x1, y1),

        (x2, y2),

        (255, 255, 255),

        -1
    )


    # ========================================================
    # ONLY LAST FOUR
    # ========================================================

    visible_text = (

        "XXXX XXXX "

        +

        number[-4:]
    )


    font = (
        cv2.FONT_HERSHEY_SIMPLEX
    )


    box_width = max(

        1,

        x2 - x1
    )


    box_height = max(

        1,

        y2 - y1
    )


    font_scale = max(

        0.30,

        min(

            1.20,

            box_height / 38.0
        )
    )


    thickness = max(

        1,

        int(
            font_scale * 2
        )
    )


    # ========================================================
    # FIT TEXT
    # ========================================================

    while True:


        (
            text_width,
            text_height
        ), baseline = cv2.getTextSize(

            visible_text,

            font,

            font_scale,

            thickness
        )


        if (

            text_width
            <=
            box_width - 4

            or

            font_scale <= 0.25
        ):

            break


        font_scale -= 0.05


        thickness = max(

            1,

            int(
                font_scale * 2
            )
        )


    # ========================================================
    # CENTER
    # ========================================================

    text_x = (

        x1

        +

        max(

            2,

            (
                box_width
                -
                text_width
            )
            //
            2
        )
    )


    text_y = (

        y1

        +

        (
            box_height
            +
            text_height
        )
        //
        2
    )


    text_x = max(

        0,

        min(

            text_x,

            width
            -
            text_width
            -
            1
        )
    )


    text_y = max(

        text_height,

        min(

            text_y,

            height - 1
        )
    )


    # ========================================================
    # DRAW
    # ========================================================

    cv2.putText(

        canvas,

        visible_text,

        (
            text_x,
            text_y
        ),

        font,

        font_scale,

        (0, 0, 0),

        thickness,

        cv2.LINE_AA
    )


    return visible_text


