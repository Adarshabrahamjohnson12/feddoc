# Card-number OCR
# ---------------------------------------------------------------------------

def _read_digits_from_ocr_result(
    result,
    scale_factor,
    offset,
):
    ox, oy = offset

    lines = result[0] if result else None

    tokens = []

    for line in lines or []:
        try:
            points, (text, confidence) = line
        except (TypeError, ValueError):
            continue

        raw = str(text)
        digits = re.sub(r"\D", "", raw)

        if not digits:
            continue

        points = np.asarray(points, dtype=np.float32)

        x1, y1 = points.min(axis=0) / scale_factor
        x2, y2 = points.max(axis=0) / scale_factor

        tokens.append(
            {
                "raw": raw,
                "digits": digits,
                "groups": [len(digits)],
                "conf": float(confidence) * 100,
                "src": "paddle",
                "box": (
                    ox + x1,
                    oy + y1,
                    ox + x2,
                    oy + y2,
                ),
            }
        )

    return tokens


def read_card_number(img, box):
    """
    OCR only the RF-DETR Aadhaar-number crop.

    Optimization:
        - OCR upright first.
        - If upright gives a valid 12-digit Verhoeff number, STOP.
        - Only then try 180 degrees.
    """
    x1, y1, x2, y2 = map(int, box)

    pad = 6

    X1 = max(0, x1 - pad)
    Y1 = max(0, y1 - pad)
    X2 = min(img.shape[1], x2 + pad)
    Y2 = min(img.shape[0], y2 + pad)

    crop = img[Y1:Y2, X1:X2]

    if crop.size == 0:
        return {
            "upside_down": False,
            "cut": None,
        }

    scale_factor = max(
        1.0,
        min(
            4.0,
            90.0 / max(1, crop.shape[0]),
        ),
    )

    if scale_factor != 1.0:
        prepared = cv2.resize(
            crop,
            None,
            fx=scale_factor,
            fy=scale_factor,
            interpolation=cv2.INTER_CUBIC,
        )
    else:
        prepared = crop

    def read(image):
        bgr = cv2.cvtColor(
            image,
            cv2.COLOR_RGB2BGR,
        )

        with timed("card_ocr"):
            result = PADDLE_OCR.ocr(
                bgr,
                cls=True,
            )

        tokens = _read_digits_from_ocr_result(
            result,
            scale_factor,
            (X1, Y1),
        )

        digits = "".join(
            token["digits"]
            for token in tokens
        )

        confidence = (
            float(
                np.mean(
                    [token["conf"] for token in tokens]
                )
            )
            if tokens
            else 0.0
        )

        return tokens, digits, confidence

    # First pass: normal orientation.
    tokens, digits, score = read(prepared)

    if len(digits) == 12 and verhoeff(digits):
        cut = digit_cut_x(
            {
                "tokens": tokens,
                "digits": digits,
            }
        )

        return {
            "upside_down": False,
            "cut": cut,
        }

    # Only do the second OCR pass if the first pass failed validation.
    rotated = cv2.rotate(
        prepared,
        cv2.ROTATE_180,
    )

    tokens180, digits180, score180 = read(rotated)

    if len(digits180) == 12 and verhoeff(digits180):
        # Convert rotated OCR token coordinates back to original image space.
        h, w = prepared.shape[:2]

        converted = []

        for token in tokens180:
            bx1, by1, bx2, by2 = token["box"]

            # token["box"] is relative to the original image because
            # _read_digits_from_ocr_result includes X1/Y1.
            rx1 = bx1 - X1
            ry1 = by1 - Y1
            rx2 = bx2 - X1
            ry2 = by2 - Y1

            ox1 = w - rx2
            oy1 = h - ry2
            ox2 = w - rx1
            oy2 = h - ry1

            converted.append(
                {
                    **token,
                    "box": (
                        X1 + ox1 / scale_factor,
                        Y1 + oy1 / scale_factor,
                        X1 + ox2 / scale_factor,
                        Y1 + oy2 / scale_factor,
                    ),
                }
            )

        cut = digit_cut_x(
            {
                "tokens": converted,
                "digits": digits180,
            }
        )

        return {
            "upside_down": True,
            "cut": cut,
        }

    if args.debug:
        print(
            "  [CARD OCR] "
            "RF-DETR number region rejected by OCR/Verhoeff"
        )

    return {
        "upside_down": False,
        "cut": None,
    }


# ---------------------------------------------------------------------------
# Candidate masking from text/OCR
# ---------------------------------------------------------------------------

def mask_text_candidates(
    img,
    cov,
    words,
    digit_tokens,
):
    candidates_found = candidates(
        build_runs(digit_tokens)
    )

    # Verhoeff-valid candidates first.
    candidates_found.sort(
        key=lambda c: not verhoeff(c["digits"])
    )

    jobs = []

    for candidate in candidates_found:
        if not accept(candidate):
            continue

        if any(
            overlap(candidate["box"], old_box) > 0.5
            for old_box, _ in jobs
        ):
            continue

        cut = digit_cut_x(candidate)

        # Refinement is CPU work, but only on confirmed candidates.
        cut = refine_cut(
            img,
            candidate["box"],
            cut,
        )

        jobs.append(
            (
                candidate["box"],
                cut,
            )
        )

    masked = 0

    for box, cut in jobs:
        if covered(cov, box):
            continue

        with timed("masking"):
            ok = mask_number(
                img,
                cov,
                box,
                cut,
            )

        if ok:
            STATS["typed"] += 1
            masked += 1

    return masked


# ---------------------------------------------------------------------------
# RF-DETR result application
# ---------------------------------------------------------------------------

def detect_page(img):
    """
    Fast path:
        1. One whole-page RF-DETR inference.
        2. Only if it finds nothing, fall back to tiles.

    This preserves a small-object recovery path without paying the tile
    cost on every page.
    """
    detections = detect(
        img,
        tag="page-full",
        force_tiles=False,
    )

    if detections or args.tile <= 0:
        return detections

    return detect(
        img,
        tag="page-tiles",
        force_tiles=True,
    )


def apply_model_detections(
    img,
    cov,
    detections,
):
    """
    Apply RF-DETR detections.

    Important:
        QR detections are masked directly.
        We do not run QRCodeDetector over the entire page repeatedly.
    """
    H, W = img.shape[:2]

    for name, box, conf in detections:
        if covered(cov, box):
            continue

        width = box[2] - box[0]
        height = box[3] - box[1]

        if width <= 0 or height <= 0:
            continue

        if name == "QR":
            aspect_ratio = width / max(height, 1.0)

            # Keep the same conservative geometry checks as before.
            if conf < 0.5:
                continue

            if not 0.75 <= aspect_ratio <= 1.35:
                continue

            if width * height > 0.12 * W * H:
                continue

            with timed("masking"):
                black_out(
                    img,
                    cov,
                    box,
                )

            continue

        if name != "AADHAAR_NUMBER":
            continue

        # Aadhaar number should be wider than tall in upright orientation.
        # Sideways cards are handled by the embedded-region rotation path.
        if width < 1.5 * height:
            continue

        info = read_card_number(
            img,
            box,
        )

        if info["cut"] is None:
            continue

        cut = refine_cut(
            img,
            box,
            info["cut"],
        )

        with timed("masking"):
            if mask_number(
                img,
                cov,
                box,
                cut,
            ):
                STATS["card_number"] += 1


# ---------------------------------------------------------------------------
# Embedded-image discovery
# ---------------------------------------------------------------------------

def embedded_regions(page, W, H):
    """
    Find meaningful embedded images.

    Full-page scan/background images are intentionally skipped because the
    page-level detector handles them.
    """
    regions = []

    for info in page.get_images(full=True):
        try:
            rects = page.get_image_rects(info[0])
        except Exception:
            continue

        for rect in rects:
            box = clip(
                (
                    rect.x0 * args.render_scale,
                    rect.y0 * args.render_scale,
                    rect.x1 * args.render_scale,
                    rect.y1 * args.render_scale,
                ),
                W,
                H,
            )

            width = box[2] - box[0]
            height = box[3] - box[1]

            if width < W * MIN_REGION_W_FRAC:
                continue

            if height < H * MIN_REGION_H_FRAC:
                continue

            if width > W * 0.95 and height > H * 0.90:
                continue

            if any(
                iou(box, old) > 0.90
                for old in regions
            ):
                continue

            regions.append(box)

    return regions


# ---------------------------------------------------------------------------
# Rotated embedded region processing
# ---------------------------------------------------------------------------

def process_embedded_region(
    img,
    cov,
    box,
):
    """
    Embedded Aadhaar cards may be sideways.

    We therefore rotate ONLY the candidate embedded region, not the entire
    page. This is much cheaper than the original 4 full-page passes.
    """
    x1, y1, x2, y2 = map(int, box)

    region = img[y1:y2, x1:x2]

    if region.size == 0:
        return

    region_cov = cov[y1:y2, x1:x2]

    rotations = (
        (None, None),
        (
            cv2.ROTATE_90_CLOCKWISE,
            cv2.ROTATE_90_COUNTERCLOCKWISE,
        ),
        (
            cv2.ROTATE_180,
            cv2.ROTATE_180,
        ),
        (
            cv2.ROTATE_90_COUNTERCLOCKWISE,
            cv2.ROTATE_90_CLOCKWISE,
        ),
    )

    for rot, inverse in rotations:
        if rot is None:
            rotated = region
            rotated_cov = region_cov
        else:
            rotated = cv2.rotate(
                region,
                rot,
            )
            rotated_cov = cv2.rotate(
                region_cov,
                rot,
            )

        # One detector call for this orientation.
        detections = detect(
            rotated,
            tag="embedded",
            force_tiles=False,
        )

        apply_model_detections(
            rotated,
            rotated_cov,
            detections,
        )

        if rot is not None:
            region = cv2.rotate(
                rotated,
                inverse,
            )
            region_cov = cv2.rotate(
                rotated_cov,
                inverse,
            )

            # Continue from the newly masked orientation.
        else:
            region = rotated
            region_cov = rotated_cov

    # Write final region back once.
    img[y1:y2, x1:x2] = region
    cov[y1:y2, x1:x2] = region_cov


# ---------------------------------------------------------------------------
# Page processing
# ---------------------------------------------------------------------------

def process_page(
    page,
    img,
    cov,
):
    """
    Optimized page pipeline:

        1. Native PDF text
        2. PaddleOCR once
        3. Embedded regions / rotated RF-DETR
        4. One page-level RF-DETR pass

    The page detector is intentionally not repeated at 90/180/270 degrees.
    """
    page_start = time.perf_counter()

    H, W = img.shape[:2]

    # ---------------------------------------------------------------
    # 1. Native PDF text
    # ---------------------------------------------------------------
    with timed("native_text"):
        native_words, native_digits = pdf_text_tokens(
            page,
            args.render_scale,
        )

    native_hit = False

    if native_digits:
        native_hit = (
            mask_text_candidates(
                img,
                cov,
                native_words,
                native_digits,
            )
            > 0
        )

    # ---------------------------------------------------------------
    # 2. Full-page PaddleOCR
    # ---------------------------------------------------------------
    # OCR is still required for rasterized/embedded printed numbers.
    # Optionally skip it if native text already found a valid number.
    if not (
        args.skip_page_ocr_if_native_hit
        and native_hit
    ):
        ocr_words, ocr_digits = ocr_tokens(img)

        # Native PDF text has already been processed above. Do not merge
        # native + OCR tokens here: doing so can duplicate the same printed
        # number and create artificial 12-digit candidates.
        mask_text_candidates(
            img,
            cov,
            ocr_words,
            ocr_digits,
        )

    # ---------------------------------------------------------------
    # 3. Embedded image regions
    # ---------------------------------------------------------------
    regions_start = time.perf_counter()

    regions = embedded_regions(
        page,
        W,
        H,
    )

    if args.profile:
        PROFILE_TOTALS["embedded_detection"] += (
            time.perf_counter() - regions_start
        )

    for region_box in regions:
        process_embedded_region(
            img,
            cov,
            region_box,
        )

    # ---------------------------------------------------------------
    # 4. One whole-page RF-DETR pass
    # ---------------------------------------------------------------
    if MODEL is not None:
        detections = detect_page(img)

        apply_model_detections(
            img,
            cov,
            detections,
        )

    return regions, time.perf_counter() - page_start


# ---------------------------------------------------------------------------
# PDF rendering
# ---------------------------------------------------------------------------

def render_page(page):
    pix = page.get_pixmap(
        matrix=fitz.Matrix(
            args.render_scale,
            args.render_scale,
        ),
        alpha=False,
    )

    array = np.frombuffer(
        pix.samples,
        dtype=np.uint8,
    ).reshape(
        pix.height,
        pix.width,
        pix.n,
    )

    if pix.n == 4:
        array = cv2.cvtColor(
            array,
            cv2.COLOR_RGBA2RGB,
        )
    elif pix.n == 1:
        array = cv2.cvtColor(
            array,
            cv2.COLOR_GRAY2RGB,
        )
    else:
        # The pixmap buffer is owned by PyMuPDF. Make one writable copy.
        array = array.copy()

    if not array.flags.writeable:
        array = array.copy()

    return array


# ---------------------------------------------------------------------------
# Output PDF
# ---------------------------------------------------------------------------

def encode_page_png(img):
    with timed("pdf_encode"):
        ok, encoded = cv2.imencode(
            ".png",
            cv2.cvtColor(
                img,
                cv2.COLOR_RGB2BGR,
            ),
        )

    if not ok:
        raise RuntimeError(
            "Failed to encode processed page as PNG"
        )

    return encoded.tobytes()


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def get_input_pdfs():
    if INPUT_PDF is None:
        files = sorted(
            (ROOT / "input" / "Files").glob("*.pdf"),
            key=lambda path: path.name.casefold(),
        )

        if not files:
            raise SystemExit(
                f"No PDF files found in {ROOT / 'input' / 'Files'}"
            )

        return files

    if not INPUT_PDF.is_file():
        raise SystemExit(
            f"Input PDF not found: {INPUT_PDF}"
        )

    return [INPUT_PDF]


def reset_stats():
    for key in STATS:
        STATS[key] = 0


def reset_profile():
    for key in PROFILE_TOTALS:
        PROFILE_TOTALS[key] = 0.0


def print_profile():
    if not args.profile:
        return

    print("\n--- PROFILE ---")

    total = sum(PROFILE_TOTALS.values())

    for key, value in PROFILE_TOTALS.items():
        if value > 0:
            pct = (
                100.0 * value / total
                if total > 0
                else 0.0
            )

            print(
                f"{key:22s} "
                f"{value:9.3f} s "
                f"{pct:6.1f}%"
            )

    print("----------------")


def process_pdf(input_pdf: Path, output_pdf: Path):
    reset_stats()
    reset_profile()

    output_pdf.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    pdf_start = time.perf_counter()

    doc = fitz.open(input_pdf)
    out_doc = fitz.open()

    try:
        page_count = len(doc)

        for page_index, page in enumerate(doc):
            before = dict(STATS)

            # -------------------------------------------------------
            # Render
            # -------------------------------------------------------
            with timed("render"):
                img = render_page(page)

            H, W = img.shape[:2]

            cov = np.zeros(
                (H, W),
                dtype=np.uint8,
            )

            # -------------------------------------------------------
            # Process
            # -------------------------------------------------------
            regions, page_elapsed = process_page(
                page,
                img,
                cov,
            )

            # -------------------------------------------------------
            # Statistics
            # -------------------------------------------------------
            delta = {
                key: STATS[key] - before[key]
                for key in STATS
            }

            if args.profile:
                print(
                    f"\nPAGE {page_index + 1}/{page_count} "
                    f"size={W}x{H} "
                    f"embedded={len(regions)} "
                    f"page_time={page_elapsed:.2f}s"
                )

                print(
                    "  masked:",
                    delta,
                )
            else:
                print(
                    f"PAGE {page_index + 1}/{page_count} "
                    f"embedded={len(regions)} "
                    f"masked={delta}"
                )

            # -------------------------------------------------------
            # Output page
            # -------------------------------------------------------
            encoded = encode_page_png(img)

            new_page = out_doc.new_page(
                width=page.rect.width,
                height=page.rect.height,
            )

            new_page.insert_image(
                new_page.rect,
                stream=encoded,
            )

        if len(out_doc) != len(doc):
            raise RuntimeError(
                "Page count mismatch"
            )

        with timed("pdf_save"):
            out_doc.save(
                output_pdf,
                garbage=4,
                deflate=True,
            )

    finally:
        out_doc.close()
        doc.close()

    elapsed = time.perf_counter() - pdf_start

    print(
        f"\nMasked PDF: {output_pdf}"
    )

    print(f"PDF time: {elapsed:.2f}s")

    print(
        "Total masked:",
        STATS,
    )

    print_profile()

    return elapsed


def main():
    input_pdfs = get_input_pdfs()

    print(
        f"Render scale: {args.render_scale}"
    )
    print(
        f"RF-DETR tile: {args.tile}"
    )
    print(
        f"Tile overlap: {args.tile_overlap:.2f}"
    )
    print(
        f"RF-DETR: {'enabled' if MODEL is not None else 'disabled'}"
    )
    print(
        "Handwritten Aadhaar: disabled"
    )

    total_start = time.perf_counter()

    for input_pdf in input_pdfs:
        if args.input_pdf is None:
            output_pdf = (
                ROOT
                / "output"
                / f"{input_pdf.stem}_masked.pdf"
            )
        else:
            output_pdf = OUTPUT_PDF

        process_pdf(
            input_pdf,
            output_pdf,
        )

    total_elapsed = time.perf_counter() - total_start

    print(
        f"\nTotal elapsed: {total_elapsed:.2f}s"
    )


if __name__ == "__main__":
    main()
