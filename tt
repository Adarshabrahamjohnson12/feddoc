# File: templates/universal-pipeline.yml

# Bank's Central Reusable Multi-Language CI/CD Pipeline Template

# Automatically detects and builds .NET (C#), Python, Node.js, Java (Maven), or Docker projects
 
stages:

  - validate

  - test

  - build

  - deploy_uat

  - verify_uat
 
variables:

  APP_NAME: "$CI_PROJECT_NAME"

  APP_PORT: "8080"

  HEALTHCHECK_ENDPOINT: "/health"

  STARTUP_CMD: ""
 
# -------------------------------------------------------------------------

# STAGE 1: CI VALIDATION (Auto-Detect Tech Stack & Security Contract)

# -------------------------------------------------------------------------

validate_project:

  stage: validate

  script:

    - echo "=== [BANK CI/CD] Validating Repository Contract for $APP_NAME ==="

    - |

      python -c "

      import os, sys, glob

      stack = []

      if glob.glob('*.csproj') or glob.glob('*.sln'): stack.append('.NET (C#)')

      if os.path.exists('requirements.txt'): stack.append('Python')

      if os.path.exists('package.json'): stack.append('Node.js')

      if os.path.exists('pom.xml'): stack.append('Java (Maven)')

      if os.path.exists('Dockerfile'): stack.append('Docker')

      if not stack:

          print('ERROR: No supported project manifest found (.csproj, requirements.txt, package.json, pom.xml, or Dockerfile)!')

          sys.exit(1)

      print(f'Auto-Detected Project Stack: {stack}')

      print('Security & Structure Validation PASSED!')

      "
 
# -------------------------------------------------------------------------

# STAGE 2: AUTOMATED TESTS (Multi-Language Auto-Detection)

# -------------------------------------------------------------------------

run_automated_tests:

  stage: test

  script:

    - echo "=== [BANK CI/CD] Running Automated Tests for $APP_NAME ==="

    - |

      python -c "

      import os, subprocess, sys, glob

      def run(cmd):

          print(f'>> Executing: {cmd}')

          sys.exit(subprocess.call(cmd, shell=True))
 
      if glob.glob('*.csproj') or glob.glob('*.sln'):

          print('Detected .NET project. Restoring & running dotnet test...')

          run('dotnet test --nologo')

      elif os.path.exists('requirements.txt'):

          print('Detected Python project. Installing dependencies & running pytest...')

          subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-r', 'requirements.txt'])

          run(f'{sys.executable} -m pytest -v')

      elif os.path.exists('package.json'):

          print('Detected Node.js project. Running npm install & npm test...')

          subprocess.check_call('npm install', shell=True)

          run('npm test')

      elif os.path.exists('pom.xml'):

          print('Detected Java Maven project. Running mvn test...')

          run('mvn test -B')

      else:

          print('No standard test runner detected, skipping language-specific tests.')

      "
 
# -------------------------------------------------------------------------

# STAGE 3: BUILD ARTIFACT (Universal Packaging)

# -------------------------------------------------------------------------

build_artifact:

  stage: build

  script:

    - echo "=== [BANK CI/CD] Building Release Artifact for $APP_NAME ($CI_COMMIT_SHORT_SHA) ==="

    - |

      python -c "

      import os, shutil, subprocess, sys, glob

      os.makedirs('build_output', exist_ok=True)

      if glob.glob('*.csproj') or glob.glob('*.sln'):

          print('Publishing .NET Release Artifact into build_output/...')

          sys.exit(subprocess.call('dotnet publish -c Release -o build_output --nologo', shell=True))

      elif os.path.exists('pom.xml'):

          print('Packaging Java JAR via Maven...')

          subprocess.check_call('mvn package -DskipTests -B', shell=True)

      elif os.path.exists('package.json'):

          print('Packaging Node.js application...')

          subprocess.call('npm run build --if-present', shell=True)

      for item in os.listdir('.'):

          if item not in ['build_output', '.git', '__pycache__', '.pytest_cache', 'node_modules']:

              if os.path.isfile(item):

                  shutil.copy2(item, 'build_output/')

      print('Universal artifact packaged into build_output/ directory!')

      "

  artifacts:

    paths:

      - build_output/

    expire_in: 1 week
 
# -------------------------------------------------------------------------

# STAGE 4: UAT DEPLOYMENT (Controlled Deployment to UAT Environment)

# -------------------------------------------------------------------------

deploy_to_uat:

  stage: deploy_uat

  environment:

    name: uat

    url: http://localhost:$APP_PORT

  script:

    - echo "=== [BANK CI/CD] Deploying $APP_NAME to UAT Infrastructure (Port $APP_PORT) ==="

    - |

      python -c "

      import os, subprocess, sys, time, glob, shutil

      port = os.environ.get('APP_PORT', '8080')

      app_name = os.environ.get('APP_NAME', 'app')

      custom_cmd = os.environ.get('STARTUP_CMD', '').strip()
 
      csproj = glob.glob('*.csproj')

      if csproj and os.name == 'nt':

          subprocess.call('taskkill /F /IM dotnet.exe', shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

          time.sleep(1)
 
      uat_dir = f'C:/UAT_Apps/{app_name}'

      if os.path.exists('build_output'):

          shutil.rmtree(uat_dir, ignore_errors=True)

          shutil.copytree('build_output', uat_dir, dirs_exist_ok=True)
 
      if custom_cmd:

          cmd = custom_cmd

      elif csproj:

          dll_name = os.path.splitext(csproj[0])[0] + '.dll'

          cmd = f'dotnet {uat_dir}/{dll_name} --urls http://127.0.0.1:{port}'

      elif os.path.exists('main.py'):

          cmd = f'{sys.executable} -m uvicorn main:app --host 127.0.0.1 --port {port}'

      elif os.path.exists('package.json'):

          cmd = 'npm start'

      else:

          cmd = ''
 
      if cmd:

          print(f'Starting UAT service with command: {cmd}')

          flags = subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.DETACHED_PROCESS if os.name == 'nt' else 0

          subprocess.Popen(cmd, shell=True, creationflags=flags, close_fds=True)

          time.sleep(4)

          print(f'UAT Service deployed and listening on http://localhost:{port}')

      "
 
# -------------------------------------------------------------------------

# STAGE 5: POST-DEPLOYMENT VERIFICATION (Health Checks & Status)

# -------------------------------------------------------------------------

verify_uat_deployment:

  stage: verify_uat

  script:

    - echo "=== [BANK CI/CD] Verifying Live UAT Deployment ==="

    - |

      python -c "

      import os, sys, time, urllib.request

      port = os.environ.get('APP_PORT', '8080')

      endpoint = os.environ.get('HEALTHCHECK_ENDPOINT', '/health')

      url = f'http://127.0.0.1:{port}{endpoint}'

      print(f'Probing live UAT endpoint: {url}')

      for attempt in range(1, 6):

          try:

              res = urllib.request.urlopen(url, timeout=5)

              body = res.read().decode()

              print(f'HTTP {res.status} OK -> Response: {body}')

              print('Post-Deployment Verification PASSED! UAT is live and healthy.')

              sys.exit(0)

          except Exception as e:

              print(f'Attempt {attempt}/5 waiting for service... ({e})')

              time.sleep(2)

      print('ERROR: UAT Healthcheck failed after 5 attempts!')

      sys.exit(1)

      "

