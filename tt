def clip_box(
    box,
    width,
    height
):

    x1, y1, x2, y2 = box

    x1 = max(
        0,
        min(
            int(x1),
            width - 1
        )
    )

    y1 = max(
        0,
        min(
            int(y1),
            height - 1
        )
    )

    x2 = max(
        0,
        min(
            int(x2),
            width
        )
    )

    y2 = max(
        0,
        min(
            int(y2),
            height
        )
    )

    return (
        x1,
        y1,
        x2,
        y2
    )


def expand_box(
    box,
    width,
    height,
    margin_x,
    margin_y
):

    x1, y1, x2, y2 = box

    return clip_box(

        (
            x1 - margin_x,
            y1 - margin_y,
            x2 + margin_x,
            y2 + margin_y
        ),

        width,
        height
    )


def box_iou(
    a,
    b
):

    ax1, ay1, ax2, ay2 = a

    bx1, by1, bx2, by2 = b

    ix1 = max(
        ax1,
        bx1
    )

    iy1 = max(
        ay1,
        by1
    )

    ix2 = min(
        ax2,
        bx2
    )

    iy2 = min(
        ay2,
        by2
    )

    if (
        ix2 <= ix1
        or
        iy2 <= iy1
    ):

        return 0.0

    intersection = (

        (ix2 - ix1)
        *
        (iy2 - iy1)
    )

    area_a = (

        max(
            0,
            ax2 - ax1
        )
        *
        max(
            0,
            ay2 - ay1
        )
    )

    area_b = (

        max(
            0,
            bx2 - bx1
        )
        *
        max(
            0,
            by2 - by1
        )
    )

    union = (

        area_a
        +
        area_b
        -
        intersection
    )

    if union <= 0:

        return 0.0

    return (
        intersection / union
    )


# ============================================================
# 8. GENERIC TESSERACT AADHAAR DETECTION
#
# Used mainly for:
#
# Embedded Aadhaar images
#
# Requires:
#
# 12 digits
# +
# Verhoeff valid
#
# ============================================================

def find_aadhaar_candidates(
    image
):

    height, width = (
        image.shape[:2]
    )

    versions = []


    # --------------------------------------------------------
    # ORIGINAL
    # --------------------------------------------------------

    versions.append(
        (
            "original",
            image,
            1.0
        )
    )


    # --------------------------------------------------------
    # 3X UPSCALE
    # --------------------------------------------------------

    upscaled = cv2.resize(

        image,

        None,

        fx=3,

        fy=3,

        interpolation=cv2.INTER_CUBIC
    )

    versions.append(
        (
            "upscaled",
            upscaled,
            3.0
        )
    )


    # --------------------------------------------------------
    # GRAY
    # --------------------------------------------------------

    gray = cv2.cvtColor(

        upscaled,

        cv2.COLOR_RGB2GRAY
    )

    versions.append(
        (
            "gray",
            gray,
            3.0
        )
    )


    # --------------------------------------------------------
    # ADAPTIVE
    # --------------------------------------------------------

    adaptive = cv2.adaptiveThreshold(

        gray,

        255,

        cv2.ADAPTIVE_THRESH_GAUSSIAN_C,

        cv2.THRESH_BINARY,

        31,

        11
    )

    versions.append(
        (
            "adaptive",
            adaptive,
            3.0
        )
    )


    # --------------------------------------------------------
    # OTSU
    # --------------------------------------------------------

    _, otsu = cv2.threshold(

        gray,

        0,

        255,

        cv2.THRESH_BINARY
        +
        cv2.THRESH_OTSU
    )

    versions.append(
        (
            "otsu",
            otsu,
            3.0
        )
    )


    candidates = []


    # ========================================================
    # OCR
    # ========================================================

    ocr_jobs = [
        (
            version_name,
            processed,
            scale,
            psm,
            f"--psm {psm} -c tessedit_char_whitelist=0123456789"
        )
        for version_name, processed, scale in versions
        for psm in (6, 11, 12)
    ]
    ocr_results = run_image_to_data_batch([
        (processed, config)
        for _, processed, _, _, config in ocr_jobs
    ])
    for (version_name, processed, scale, psm, _), data in zip(
        ocr_jobs,
        ocr_results
    ):


            tokens = []


            # =================================================
            # OCR TOKENS
            # =================================================

            for i in range(
                len(data["text"])
            ):

                raw = str(
                    data["text"][i]
                ).strip()


                if not raw:

                    continue


                digits = re.sub(
                    r"\D",
                    "",
                    raw
                )


                if not digits:

                    continue


                try:

                    confidence = float(
                        data["conf"][i]
                    )

                except:

                    confidence = -1


                if confidence < 0:

                    continue


                x = int(
                    data["left"][i]
                )

                y = int(
                    data["top"][i]
                )

                tw = int(
                    data["width"][i]
                )

                th = int(
                    data["height"][i]
                )


                if (
                    tw <= 0
                    or
                    th <= 0
                ):

                    continue


                ox1 = (
                    x / scale
                )

                oy1 = (
                    y / scale
                )

                ox2 = (
                    x + tw
                ) / scale

                oy2 = (
                    y + th
                ) / scale


                tokens.append(

                    {
                        "digits": digits,

                        "confidence":
                            confidence,

                        "x1": ox1,

                        "y1": oy1,

                        "x2": ox2,

                        "y2": oy2,

                        "cx":
                            (ox1 + ox2) / 2,

                        "cy":
                            (oy1 + oy2) / 2
                    }
                )


            tokens.sort(

                key=lambda t: (

                    round(
                        t["cy"] / 25
                    ),

                    t["x1"]
                )
            )


            # =================================================
            # SEARCH 12 DIGITS
            # =================================================

            for start in range(
                len(tokens)
            ):

                combined = ""

                selected = []

                previous = None


                for j in range(

                    start,

                    min(
                        start + 4,
                        len(tokens)
                    )
                ):

                    token = tokens[j]


                    if previous is not None:

                        y_distance = abs(

                            token["cy"]

                            -

                            previous["cy"]
                        )


                        x_gap = (

                            token["x1"]

                            -

                            previous["x2"]
                        )


                        if y_distance > 40:

                            break


                        if x_gap > 220:

                            break


                    combined += (
                        token["digits"]
                    )


                    selected.append(
                        token
                    )


                    previous = token


                    if len(combined) > 12:

                        break


                    if len(combined) == 12:


                        # -------------------------------------
                        # VERHOEFF
                        # -------------------------------------

                        if not verhoeff_validate(
                            combined
                        ):

                            break


                        x1 = min(
                            t["x1"]
                            for t in selected
                        )

                        y1 = min(
                            t["y1"]
                            for t in selected
                        )

                        x2 = max(
                            t["x2"]
                            for t in selected
                        )

                        y2 = max(
                            t["y2"]
                            for t in selected
                        )


                        bw = (
                            x2 - x1
                        )

                        bh = (
                            y2 - y1
                        )


                        if (
                            bw <= 0
                            or
                            bh <= 0
                        ):

                            break


                        if (
                            bw / bh < 1.3
                        ):

                            break


                        candidates.append(

                            {

                                "number":
                                    combined,

                                "box":
                                    (
                                        x1,
                                        y1,
                                        x2,
                                        y2
                                    ),

                                "confidence":
                                    min(

                                        t[
                                            "confidence"
                                        ]

                                        for t
                                        in selected
                                    ),

                                "method":
                                    version_name,

                                "psm":
                                    psm
                            }
                        )


                        break


    # ========================================================
    # DEDUPLICATE
    # ========================================================

    unique = []


    for candidate in candidates:

        duplicate = False


        for existing in unique:

            if (

                candidate[
                    "number"
                ]

                ==

                existing[
                    "number"
                ]
            ):

                if (

                    box_iou(

                        candidate[
                            "box"
                        ],

                        existing[
                            "box"
                        ]
                    )

                    > 0.15
                ):

                    duplicate = True

                    break


        if not duplicate:

            unique.append(
                candidate
            )


    unique.sort(

        key=lambda x:
            x["confidence"],

        reverse=True
    )


    return unique


# ============================================================
# 9. FORM-LEVEL LABEL-AWARE AADHAAR DETECTION
#
# THIS IS THE IMPORTANT NEW PART.
#
# It searches the WHOLE PAGE for:
#
#   Aadhaar Number
#   Aadhaar No
#   Aadhaar No.
#   Aadhar Number
#   Aadhar No
#   UID Number
#
# Then searches near that label for 12 digits.
#
# VERHOEFF IS NOT REQUIRED FOR THIS LABEL-ASSOCIATED CASE.
#
# ============================================================

def find_labeled_form_aadhaar_candidates(
    page_image
):

    height, width = (
        page_image.shape[:2]
    )


    print()
    print(
        "Searching form for Aadhaar labels..."
    )


    # ========================================================
    # CREATE OCR VERSIONS
    # ========================================================

    versions = []


    versions.append(
        (
            "original",
            page_image,
            1.0
        )
    )


    upscaled = cv2.resize(

        page_image,

        None,

        fx=2,

        fy=2,

        interpolation=cv2.INTER_CUBIC
    )


    versions.append(
        (
            "upscaled",
            upscaled,
            2.0
        )
    )


    # ========================================================
    # LABEL OCR
    #
    # Do NOT use digit whitelist here.
    # We need words such as Aadhaar.
    # ========================================================

    candidates = []


    ocr_jobs = [
        (version_name, processed, scale, psm, f"--psm {psm}")
        for version_name, processed, scale in versions
        for psm in (6, 11, 12)
    ]
    ocr_results = run_image_to_data_batch([
        (processed, config)
        for _, processed, _, _, config in ocr_jobs
    ])
    for (version_name, processed, scale, psm, _), data in zip(
        ocr_jobs,
        ocr_results
    ):


            words = []


            for i in range(
                len(data["text"])
            ):


                raw = str(
                    data["text"][i]
                ).strip()


                if not raw:

                    continue


                try:

                    confidence = float(
                        data["conf"][i]
                    )

                except:

                    confidence = -1


                if confidence < 0:

                    continue


                x = int(
                    data["left"][i]
                )

                y = int(
                    data["top"][i]
                )

                tw = int(
                    data["width"][i]
                )

                th = int(
                    data["height"][i]
                )


                if (
                    tw <= 0
                    or
                    th <= 0
                ):

                    continue


                words.append(

                    {

                        "text":
                            raw,

                        "lower":
                            raw.lower(),

                        "confidence":
                            confidence,

                        "x1":
                            x / scale,

                        "y1":
                            y / scale,

                        "x2":
                            (x + tw) / scale,

                        "y2":
                            (y + th) / scale,

                        "cx":
                            (x + tw / 2) / scale,

                        "cy":
                            (y + th / 2) / scale,

                        "line_num":
                            data[
                                "line_num"
                            ][i]
                    }
                )


            # =================================================
            # FIND AADHAAR LABELS
            # =================================================

            label_indices = []


            for i, word in enumerate(
                words
            ):


                normalized = re.sub(

                    r"[^a-z]",

                    "",

                    word["lower"]
                )


                # ---------------------------------------------
                # Direct Aadhaar/Aadhar label
                # ---------------------------------------------

                if (

                    "aadhaar"
                    in
                    normalized

                    or

                    "aadhar"
                    in
                    normalized
                ):

                    label_indices.append(
                        i
                    )

                    continue


                # ---------------------------------------------
                # UID label
                # ---------------------------------------------

                if normalized == "uid":

                    label_indices.append(
                        i
                    )


            if not label_indices:

                continue


            # =================================================
            # OCR DIGITS SEPARATELY
            # =================================================

            digit_data = pytesseract.image_to_data(

                processed,

                config=(
                    f"--psm {psm} "
                    "-c tessedit_char_whitelist=0123456789"
                ),

                output_type=Output.DICT
            )


            digit_tokens = []


            for i in range(
                len(
                    digit_data["text"]
                )
            ):


                raw = str(
                    digit_data["text"][i]
                ).strip()


                if not raw:

                    continue


                digits = re.sub(
                    r"\D",
                    "",
                    raw
                )


                if not digits:

                    continue


                try:

                    confidence = float(
                        digit_data["conf"][i]
                    )

                except:

                    confidence = -1


                if confidence < 0:

                    continue


                x = int(
                    digit_data["left"][i]
                )

                y = int(
                    digit_data["top"][i]
                )

                tw = int(
                    digit_data["width"][i]
                )

                th = int(
                    digit_data["height"][i]
                )


                if (
                    tw <= 0
                    or
                    th <= 0
                ):

                    continue


                digit_tokens.append(

                    {

                        "digits":
                            digits,

                        "confidence":
                            confidence,

                        "x1":
                            x / scale,

                        "y1":
                            y / scale,

                        "x2":
                            (x + tw) / scale,

                        "y2":
                            (y + th) / scale,

                        "cx":
                            (x + tw / 2) / scale,

                        "cy":
                            (y + th / 2) / scale
                    }
                )


            # =================================================
            # MATCH NUMBERS NEAR AADHAAR LABEL
            # =================================================

            for label_index in (
                label_indices
            ):


                label = words[
                    label_index
                ]


                # ---------------------------------------------
                # Candidate digit tokens
                #
                # Allow same line or the immediately following
                # line.
                # ---------------------------------------------

                nearby = []


                for token in digit_tokens:


                    vertical_distance = abs(

                        token["cy"]

                        -

                        label["cy"]
                    )


                    # Number should be reasonably close
                    # vertically.
                    if vertical_distance > 110:

                        continue


                    # Avoid numbers far to the left.
                    #
                    # Usually Aadhaar number is after
                    # "Aadhaar Number:".
                    #
                    # But allow below-label layout too.
                    if (

                        token["cy"]
                        <
                        label["cy"] + 20

                        and

                        token["cx"]
                        <
                        label["cx"] - 20
                    ):

                        continue


                    nearby.append(
                        token
                    )


                # ---------------------------------------------
                # Sort spatially
                # ---------------------------------------------

                nearby.sort(

                    key=lambda t: (

                        round(
                            t["cy"] / 30
                        ),

                        t["x1"]
                    )
                )


                # =================================================
                # SEARCH EXACT 12 DIGITS
                #
                # NO VERHOEFF HERE
                # because this is explicitly near Aadhaar label.
                # =================================================

                for start in range(
                    len(nearby)
                ):


                    combined = ""

                    selected = []

                    previous = None


                    for j in range(

                        start,

                        min(

                            start + 4,

                            len(nearby)
                        )
                    ):


                        token = nearby[
                            j
                        ]


                        if previous is not None:


                            y_distance = abs(

                                token["cy"]

                                -

                                previous["cy"]
                            )


                            x_gap = (

                                token["x1"]

                                -

                                previous["x2"]
                            )


                            if (
                                y_distance
                                >
                                45
                            ):

                                break


                            if (
                                x_gap
                                >
                                300
                            ):

                                break


                        combined += (
                            token[
                                "digits"
                            ]
                        )


                        selected.append(
                            token
                        )


                        previous = token


                        if len(combined) > 12:

                            break


                        if len(combined) == 12:


                            x1 = min(

                                t["x1"]

                                for t
                                in selected
                            )


                            y1 = min(

                                t["y1"]

                                for t
                                in selected
                            )


                            x2 = max(

                                t["x2"]

                                for t
                                in selected
                            )


                            y2 = max(

                                t["y2"]

                                for t
                                in selected
                            )


                            candidates.append(

                                {

                                    "number":
                                        combined,

                                    "box":
                                        (
                                            x1,
                                            y1,
                                            x2,
                                            y2
                                        ),

                                    "confidence":
                                        min(

                                            t[
                                                "confidence"
                                            ]

                                            for t
                                            in selected
                                        ),

                                    "method":
                                        "LABEL_AADHAAR",

                                    "label":
                                        label[
                                            "text"
                                        ]
                                }
                            )


                            break


    # ========================================================
    # DEDUPLICATE
    # ========================================================

    unique = []


    for candidate in candidates:


        duplicate = False


        for existing in unique:


            if (

                box_iou(

                    candidate[
                        "box"
                    ],

                    existing[
                        "box"
                    ]
                )

                >

                0.30
            ):

                duplicate = True

                break


        if not duplicate:

            unique.append(
                candidate
            )


    unique.sort(

        key=lambda x:
            x["confidence"],

        reverse=True
    )


    print(
        "Label-associated Aadhaar candidates:",
        len(unique)
    )


    return unique


