                continue


            total_embedded_aadhaar_images += 1


            # =================================================
            # PUT MASKED EMBEDDED IMAGE BACK
            # =================================================

            page_image[

                py1:py2,

                px1:px2

            ] = masked_embedded


            total_embedded_aadhaar_masks += (
                aadhaar_count
            )

